<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>GlowLab: Rotina & Diagnóstico de Pele</title>
  <style>
    :root {
      --bg1: #fff5f8;
      --bg2: #f3f7ff;
      --card: #ffffff;
      --primary: #ff6b9d;
      --primary-dark: #e84e82;
      --secondary: #6c8cff;
      --mint: #2ec4b6;
      --text: #2d2a3e;
      --muted: #6e6a86;
      --border: #f0e4ec;
      --shadow: 0 10px 28px rgba(108, 86, 123, 0.12);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    body {
      min-height: 100vh;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
      background: linear-gradient(145deg, var(--bg1), var(--bg2));
      color: var(--text);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 16px;
    }

    .app {
      width: 100%;
      max-width: 480px;
      background: var(--card);
      border-radius: 28px;
      padding: 22px 20px;
      box-shadow: var(--shadow);
      border: 1px solid var(--border);
    }

    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
      font-size: 13.5px;
      font-weight: 700;
      gap: 8px;
      flex-wrap: wrap;
    }

    .pill {
      background: #fff0f5;
      color: var(--primary-dark);
      padding: 6px 12px;
      border-radius: 999px;
    }

    .pill.blue {
      background: #eef3ff;
      color: #4666e5;
    }

    .header {
      text-align: center;
      margin-bottom: 16px;
    }

    .header h1 {
      font-size: 24px;
      color: var(--text);
      margin-bottom: 4px;
    }

    .header p {
      font-size: 14px;
      color: var(--muted);
      line-height: 1.4;
    }

    .quiz-card {
      background: #fcf9fb;
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 16px;
      margin-bottom: 14px;
    }

    .quiz-q {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--text);
    }

    .quiz-options {
      display: grid;
      gap: 8px;
    }

    .opt-btn {
      width: 100%;
      text-align: left;
      background: #ffffff;
      border: 2px solid var(--border);
      border-radius: 14px;
      padding: 11px 13px;
      font-size: 13.5px;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
      transition: border-color 0.18s ease, background 0.18s ease, transform 0.12s ease;
    }

    .opt-btn:hover {
      border-color: var(--primary);
    }

    .opt-btn.selected {
      border-color: var(--primary);
      background: #fff0f6;
      color: var(--primary-dark);
    }

    .opt-btn:active {
      transform: scale(0.98);
    }

    .profile-box {
      background: linear-gradient(120deg, #fff2f7, #eef4ff);
      border: 1px solid #e6dcf5;
      border-radius: 18px;
      padding: 14px;
      margin-bottom: 16px;
      font-size: 13.5px;
      line-height: 1.45;
    }

    .profile-box strong {
      display: block;
      font-size: 15px;
      margin-bottom: 4px;
    }

    .routine-banner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: linear-gradient(120deg, #fff4e6, #ffeef6);
      border-radius: 18px;
      padding: 12px 16px;
      margin-bottom: 16px;
      border: 1px solid #ffe0eb;
    }

    .routine-banner.night {
      background: linear-gradient(120deg, #eef2ff, #f5ebff);
      border-color: #e0e6ff;
    }

    .routine-title {
      font-weight: 800;
      font-size: 16px;
    }

    .routine-sub {
      font-size: 12px;
      color: var(--muted);
      margin-top: 2px;
    }

    .face-card {
      background: #fcf9fb;
      border: 1px dashed #e6d6e2;
      border-radius: 20px;
      padding: 14px;
      text-align: center;
      margin-bottom: 16px;
    }

    .avatar {
      font-size: 46px;
      line-height: 1.1;
      margin-bottom: 6px;
      transition: transform 0.25s ease;
    }

    .avatar.pop {
      transform: scale(1.15);
    }

    .steps-track {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 10px;
      flex-wrap: wrap;
    }

    .step-slot {
      width: 44px;
      height: 44px;
      border-radius: 14px;
      background: #ffffff;
      border: 2px dashed #dcd2df;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      font-weight: 700;
      color: #b7adc2;
      transition: all 0.2s ease;
    }

    .step-slot.done {
      border-style: solid;
      border-color: var(--mint);
      background: #e9fbf8;
      color: var(--text);
    }

    .feedback {
      min-height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 13.5px;
      font-weight: 600;
      border-radius: 14px;
      padding: 8px 12px;
      margin-bottom: 16px;
      background: #f7f7fb;
      color: var(--muted);
    }

    .feedback.ok {
      background: #e8faf6;
      color: #167c72;
    }

    .feedback.err {
      background: #fff0f0;
      color: #c93b4b;
    }

    .shelf-label {
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--muted);
      margin-bottom: 10px;
    }

    .products-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .product-btn {
      background: #ffffff;
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 12px 10px;
      text-align: left;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: transform 0.12s ease, border-color 0.2s ease, opacity 0.2s ease;
    }

    .product-btn:active {
      transform: scale(0.97);
    }

    .product-btn:hover {
      border-color: var(--primary);
    }

    .product-btn.used {
      opacity: 0.38;
      pointer-events: none;
      background: #f8f6f9;
    }

    .product-icon {
      font-size: 26px;
      flex-shrink: 0;
    }

    .product-name {
      font-size: 14px;
      font-weight: 700;
      color: var(--text);
    }

    .product-desc {
      font-size: 11.5px;
      color: var(--muted);
      margin-top: 2px;
    }

    .modal {
      text-align: center;
      padding: 10px 4px;
    }

    .hidden {
      display: none !important;
    }

    .tip-box {
      background: #f4f8ff;
      border: 1px solid #dce7ff;
      border-radius: 16px;
      padding: 14px;
      margin: 16px 0 20px;
      font-size: 14px;
      line-height: 1.5;
      color: #364166;
      text-align: left;
    }

    .tip-box strong {
      display: block;
      margin-bottom: 4px;
      color: #263875;
    }

    .primary-btn {
      width: 100%;
      border: none;
      border-radius: 16px;
      padding: 14px 20px;
      font-size: 16px;
      font-weight: 800;
      color: #ffffff;
      background: linear-gradient(90deg, var(--primary), var(--secondary));
      cursor: pointer;
      box-shadow: 0 8px 18px rgba(255, 107, 157, 0.3);
    }

    .primary-btn:disabled {
      opacity: 0.45;
      cursor: not-allowed;
    }

    .primary-btn:active:not(:disabled) {
      transform: scale(0.98);
    }
  </style>
</head>
<body>
  <main class="app">
    <div class="top-bar">
      <div class="pill" id="scorePill">Glow: 0 pts</div>
      <div class="pill blue" id="skinPill">Diagnóstico</div>
      <div class="pill blue" id="roundPill">Passo 0 / 4</div>
    </div>

    <div class="header">
      <h1>✨ GlowLab Skincare</h1>
      <p id="headerSub">Responde a 2 perguntas rápidas para descobrir o teu perfil de pele e começar!</p>
    </div>

    <!-- Ecrã de diagnóstico rápido -->
    <div id="quizView">
      <div class="quiz-card">
        <div class="quiz-q">1. A meio do dia, como costumas sentir o rosto?</div>
        <div class="quiz-options" id="q1Options">
          <button type="button" class="opt-btn" data-type="oily">Brilho em quase todo o rosto e poros visíveis</button>
          <button type="button" class="opt-btn" data-type="dry">Repuxar, secura ou algumas zonas a descamar</button>
          <button type="button" class="opt-btn" data-type="combo">Zona T oleosa (testa/nariz) e faces mais normais ou secas</button>
          <button type="button" class="opt-btn" data-type="sensitive">Fica facilmente vermelha, quente ou reativa a produtos</button>
        </div>
      </div>

      <div class="quiz-card">
        <div class="quiz-q">2. Qual é o teu foco principal agora?</div>
        <div class="quiz-options" id="q2Options">
          <button type="button" class="opt-btn" data-goal="balance">Equilibrar oleosidade e manter a pele leve</button>
          <button type="button" class="opt-btn" data-goal="hydrate">Repor conforto e hidratação profunda</button>
          <button type="button" class="opt-btn" data-goal="calm">Acalmar e fortalecer a barreira da pele</button>
          <button type="button" class="opt-btn" data-goal="glow">Dar luminosidade e proteger do sol</button>
        </div>
      </div>

      <button type="button" class="primary-btn" id="startQuizBtn" disabled>Ver Diagnóstico e Jogar</button>
    </div>

    <!-- Ecrã do jogo -->
    <div id="gameView" class="hidden">
      <div class="profile-box" id="profileBox"></div>

      <div class="routine-banner" id="routineBanner">
        <div>
          <div class="routine-title" id="routineTitle">☀️ Rotina da Manhã</div>
          <div class="routine-sub" id="routineSub">Ordem: Limpar → Hidratar → Proteger</div>
        </div>
        <div style="font-size: 26px;" id="routineEmoji">🌤️</div>
      </div>

      <div class="face-card">
        <div class="avatar" id="avatar">🧖‍♀️</div>
        <div style="font-size: 13px; font-weight: 700;" id="skinStatus">Pele pronta para começar</div>
        <div class="steps-track" id="stepsTrack"></div>
      </div>

      <div class="feedback" id="feedbackBox">
        Qual é o 1.º passo desta rotina?
      </div>

      <div class="shelf-label">Prateleira de Produtos</div>
      <div class="products-grid" id="productsGrid"></div>
    </div>

    <!-- Resumo por ronda -->
    <div id="summaryView" class="modal hidden">
      <div style="font-size: 48px; margin-bottom: 8px;" id="summaryEmoji">🌟</div>
      <h2 id="summaryTitle" style="font-size: 22px; margin-bottom: 6px;">Rotina Concluída!</h2>
      <p id="summarySubtitle" style="font-size: 14px; color: var(--muted);">A tua pele ficou luminosa e protegida.</p>

      <div class="tip-box">
        <strong id="tipHeading">💡 Dica Útil de Skincare</strong>
        <span id="tipText"></span>
      </div>

      <button type="button" class="primary-btn" id="nextBtn">Próxima Rotina</button>
    </div>
  </main>

  <script>
    const SKIN_PROFILES = {
      oily: {
        label: "Pele Oleosa",
        badge: "💧 Oleosa",
        focus: "Prefere texturas em gel ou fluidas, limpeza suave sem ressecar e protetor solar de toque seco."
      },
      dry: {
        label: "Pele Seca",
        badge: "🌸 Seca",
        focus: "Beneficia de texturas cremosas, ingredientes hidratantes e selar a hidratação com creme."
      },
      combo: {
        label: "Pele Mista",
        badge: "⚖️ Mista",
        focus: "Equilibra zonas mais oleosas com hidratação leve e proteção diária uniforme."
      },
      sensitive: {
        label: "Pele Sensível",
        badge: "🌿 Sensível",
        focus: "Prioriza fórmulas suaves, sem excesso de ativos agressivos, e reforço da barreira cutânea."
      }
    };

    const ROUNDS = [
      {
        mode: "day",
        title: "☀️ Rotina da Manhã (Essencial)",
        sub: "Ordem: Limpar → Hidratar → Proteger",
        emoji: "🌤️",
        tipTitle: "Regra de ouro da manhã: do mais leve ao mais denso",
        tip: "O protetor solar é sempre o último passo da rotina de skincare da manhã (antes da maquilhagem) para criar uma barreira uniforme contra os raios UV.",
        steps: [
          { id: "cleanser", icon: "🫧", name: "Gel de Limpeza", desc: "Remove oleosidade noturna", status: "Pele limpa e fresca!" },
          { id: "moisturizer", icon: "🧴", name: "Hidratante", desc: "Mantém a barreira cutânea", status: "Pele macia e hidratada!" },
          { id: "spf", icon: "☀️", name: "Protetor Solar FPS 50", desc: "Escudo diário contra UV", status: "Glow protegido para o dia!" }
        ],
        distractors: [
          { id: "retinol", icon: "🌙", name: "Retinol", desc: "Ativo renovador noturno", wrongReason: "O retinol usa-se à noite, pois pode sensibilizar a pele ao sol." }
        ]
      },
      {
        mode: "night",
        title: "🌙 Rotina da Noite (Dupla Limpeza)",
        sub: "Remover protetor/maquilhagem e regenerar",
        emoji: "✨",
        tipTitle: "Porquê fazer dupla limpeza à noite?",
        tip: "O óleo ou bálsamo desmaquilhante dissolve protetor solar resistente e maquilhagem; o gel de limpeza a seguir limpa os poros sem deixar resíduos.",
        steps: [
          { id: "oil", icon: "💧", name: "Óleo Desmaquilhante", desc: "Dissolve FPS e maquilhagem", status: "Impurezas dissolvidas!" },
          { id: "cleanser", icon: "🫧", name: "Gel de Limpeza", desc: "Limpeza suave em profundidade", status: "Poros limpos sem repuxar!" },
          { id: "serum", icon: "🧪", name: "Sérum Reparador", desc: "Textura leve concentrada", status: "Ativos absorvidos!" },
          { id: "nightcream", icon: "🫙", name: "Creme Hidratante", desc: "Sela a hidratação à noite", status: "Pele nutrida durante o sono!" }
        ],
        distractors: [
          { id: "spf", icon: "☀️", name: "Protetor Solar", desc: "Proteção UV diurna", wrongReason: "À noite não há radiação UV — guarda o protetor solar para a manhã!" }
        ]
      },
      {
        mode: "day",
        title: "🍊 Manhã Luminosa (Antioxidante)",
        sub: "Potenciar a proteção com Vitamina C",
        emoji: "🧡",
        tipTitle: "Vitamina C + Protetor Solar = Dupla perfeita",
        tip: "Aplicar um sérum de Vitamina C antes do hidratante e do protetor solar ajuda a neutralizar radicais livres da poluição e potencia a luminosidade.",
        steps: [
          { id: "cleanser", icon: "🫧", name: "Espuma Suave", desc: "Limpeza delicada matinal", status: "Rosto limpo!" },
          { id: "vitc", icon: "🍊", name: "Sérum Vitamina C", desc: "Antioxidante iluminador", status: "Luminosidade ativada!" },
          { id: "moisturizer", icon: "🧴", name: "Hidratante Leve", desc: "Equilibra a hidratação", status: "Pele confortável!" },
          { id: "spf", icon: "☀️", name: "Protetor Solar", desc: "Último passo obrigatório", status: "Proteção máxima ativa!" }
        ],
        distractors: [
          { id: "scrub", icon: "🧂", name: "Esfoliante Forte", desc: "Uso semanal, não diário", wrongReason: "Esfoliar todos os dias irrita a barreira da pele." }
        ]
      },
      {
        mode: "night",
        title: "🌿 Noite Calmante (Barreira Cutânea)",
        sub: "Acalmar vermelhidão e recuperar o conforto",
        emoji: "🍃",
        tipTitle: "Menos é mais quando a pele pede calma",
        tip: "Em dias em que a pele arde ou está sensibilizada, evita ácidos fortes e aposta em limpeza suave, ingredientes calmantes e bom hidratante.",
        steps: [
          { id: "cleanser", icon: "🫧", name: "Leite de Limpeza", desc: "Limpa sem agredir", status: "Limpeza ultra suave!" },
          { id: "toner", icon: "💦", name: "Bruma / Tónico Calmante", desc: "Refresca e acalma", status: "Pele apaziguada!" },
          { id: "ceramides", icon: "🛡️", name: "Creme com Ceramidas", desc: "Repara a barreira cutânea", status: "Barreira restaurada!" }
        ],
        distractors: [
          { id: "aha", icon: "🍋", name: "Ácido Glicólico 10%", desc: "Esfoliante químico intenso", wrongReason: "Ácidos fortes numa pele sensível ou irritada podem aumentar o desconforto!" }
        ]
      }
    ];

    let selectedType = null;
    let selectedGoal = null;
    let roundIndex = 0;
    let currentStep = 0;
    let score = 0;
    let mistakesInRound = 0;

    const scorePill = document.getElementById("scorePill");
    const skinPill = document.getElementById("skinPill");
    const roundPill = document.getElementById("roundPill");
    const headerSub = document.getElementById("headerSub");
    const quizView = document.getElementById("quizView");
    const gameView = document.getElementById("gameView");
    const summaryView = document.getElementById("summaryView");
    const profileBox = document.getElementById("profileBox");
    const startQuizBtn = document.getElementById("startQuizBtn");
    const routineBanner = document.getElementById("routineBanner");
    const routineTitle = document.getElementById("routineTitle");
    const routineSub = document.getElementById("routineSub");
    const routineEmoji = document.getElementById("routineEmoji");
    const avatar = document.getElementById("avatar");
    const skinStatus = document.getElementById("skinStatus");
    const stepsTrack = document.getElementById("stepsTrack");
    const feedbackBox = document.getElementById("feedbackBox");
    const productsGrid = document.getElementById("productsGrid");
    const summaryEmoji = document.getElementById("summaryEmoji");
    const summaryTitle = document.getElementById("summaryTitle");
    const summarySubtitle = document.getElementById("summarySubtitle");
    const tipHeading = document.getElementById("tipHeading");
    const tipText = document.getElementById("tipText");
    const nextBtn = document.getElementById("nextBtn");

    function setupQuizListeners() {
      document.querySelectorAll("#q1Options .opt-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("#q1Options .opt-btn").forEach((b) => b.classList.remove("selected"));
          btn.classList.add("selected");
          selectedType = btn.dataset.type;
          startQuizBtn.disabled = !(selectedType && selectedGoal);
        });
      });

      document.querySelectorAll("#q2Options .opt-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("#q2Options .opt-btn").forEach((b) => b.classList.remove("selected"));
          btn.classList.add("selected");
          selectedGoal = btn.dataset.goal;
          startQuizBtn.disabled = !(selectedType && selectedGoal);
        });
      });
    }

    function shuffle(arr) {
      const copy = [...arr];
      for (let i = copy.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [copy[i], copy[j]] = [copy[j], copy[i]];
      }
      return copy;
    }

    function setFeedback(text, type = "") {
      feedbackBox.textContent = text;
      feedbackBox.className = "feedback" + (type ? " " + type : "");
    }

    function renderProfileBanner() {
      const prof = SKIN_PROFILES[selectedType] || SKIN_PROFILES.combo;
      skinPill.textContent = prof.badge;
      profileBox.innerHTML = `
        <strong>Perfil detetado: ${prof.label}</strong>
        <span>${prof.focus}</span>
      `;
    }

    function renderRound() {
      const round = ROUNDS[roundIndex];
      currentStep = 0;
      mistakesInRound = 0;

      quizView.classList.add("hidden");
      summaryView.classList.add("hidden");
      gameView.classList.remove("hidden");
      headerSub.textContent = "Toca nos produtos pela ordem certa da rotina!";

      renderProfileBanner();
      roundPill.textContent = `Ronda ${roundIndex + 1} / ${ROUNDS.length}`;
      scorePill.textContent = `Glow: ${score} pts`;

      routineBanner.className = "routine-banner" + (round.mode === "night" ? " night" : "");
      routineTitle.textContent = round.title;
      routineSub.textContent = round.sub;
      routineEmoji.textContent = round.emoji;

      avatar.textContent = "🧖‍♀️";
      skinStatus.textContent = "Pele pronta para começar";
      setFeedback("Qual é o 1.º passo desta rotina?");

      stepsTrack.innerHTML = "";
      round.steps.forEach((_, idx) => {
        const slot = document.createElement("div");
        slot.className = "step-slot";
        slot.id = "slot-" + idx;
        slot.textContent = idx + 1;
        stepsTrack.appendChild(slot);
      });

      const allItems = shuffle([
        ...round.steps.map((s, idx) => ({ ...s, stepIndex: idx })),
        ...round.distractors.map((d) => ({ ...d, stepIndex: -1 }))
      ]);

      productsGrid.innerHTML = "";
      allItems.forEach((item) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "product-btn";
        btn.innerHTML = `
          <span class="product-icon">${item.icon}</span>
          <div>
            <div class="product-name">${item.name}</div>
            <div class="product-desc">${item.desc}</div>
          </div>
        `;
        btn.addEventListener("click", () => handleSelect(item, btn));
        productsGrid.appendChild(btn);
      });
    }

    function handleSelect(item, btn) {
      const round = ROUNDS[roundIndex];

      if (item.stepIndex === currentStep) {
        btn.classList.add("used");
        const slot = document.getElementById("slot-" + currentStep);
        slot.classList.add("done");
        slot.textContent = item.icon;

        score += mistakesInRound === 0 ? 25 : 15;
        scorePill.textContent = `Glow: ${score} pts`;

        avatar.classList.remove("pop");
        void avatar.offsetWidth;
        avatar.classList.add("pop");
        skinStatus.textContent = item.status;

        currentStep += 1;

        if (currentStep >= round.steps.length) {
          avatar.textContent = "✨😊✨";
          setFeedback("Perfeito! Rotina concluída com sucesso!", "ok");
          setTimeout(showRoundSummary, 750);
        } else {
          setFeedback(`Certo! Agora escolhe o ${currentStep + 1}.º passo.`, "ok");
        }
      } else {
        mistakesInRound += 1;
        score = Math.max(0, score - 5);
        scorePill.textContent = `Glow: ${score} pts`;

        if (item.wrongReason) {
          setFeedback(item.wrongReason, "err");
        } else if (item.stepIndex > currentStep) {
          setFeedback(`Ainda é cedo para "${item.name}"! Aplica primeiro um passo mais básico.`, "err");
        } else {
          setFeedback(`Este passo vem numa fase diferente da rotina. Tenta outra ordem!`, "err");
        }
      }
    }

    function showRoundSummary() {
      const round = ROUNDS[roundIndex];
      const prof = SKIN_PROFILES[selectedType] || SKIN_PROFILES.combo;
      gameView.classList.add("hidden");
      summaryView.classList.remove("hidden");

      const isLast = roundIndex === ROUNDS.length - 1;
      summaryEmoji.textContent = isLast ? "🏆" : "🌟";
      summaryTitle.textContent = isLast ? `Parabéns! ${score} pontos Glow` : "Rotina Concluída!";
      summarySubtitle.textContent = isLast
        ? `Concluíste todas as rotinas para perfil ${prof.label.toLowerCase()}.`
        : "A tua pele ficou equilibrada, limpa e protegida.";

      tipHeading.textContent = "💡 " + round.tipTitle;
      tipText.textContent = `${round.tip} (Nota para ${prof.label.toLowerCase()}: ${prof.focus.charAt(0).toLowerCase() + prof.focus.slice(1)})`;
      nextBtn.textContent = isLast ? "Refazer Diagnóstico" : "Próxima Rotina";
    }

    startQuizBtn.addEventListener("click", () => {
      if (!selectedType || !selectedGoal) return;
      roundIndex = 0;
      score = 0;
      renderRound();
    });

    nextBtn.addEventListener("click", () => {
      if (roundIndex < ROUNDS.length - 1) {
        roundIndex += 1;
        renderRound();
      } else {
        selectedType = null;
        selectedGoal = null;
        roundIndex = 0;
        score = 0;
        scorePill.textContent = "Glow: 0 pts";
        skinPill.textContent = "Diagnóstico";
        roundPill.textContent = "Passo 0 / 4";
        headerSub.textContent = "Responde a 2 perguntas rápidas para descobrir o teu perfil de pele e começar!";
        document.querySelectorAll(".opt-btn").forEach((b) => b.classList.remove("selected"));
        startQuizBtn.disabled = true;
        summaryView.classList.add("hidden");
        gameView.classList.add("hidden");
        quizView.classList.remove("hidden");
      }
    });

    setupQuizListeners();
  </script>
</body>
</html>
